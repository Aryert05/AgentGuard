# Configure a supported LangChain chat model, e.g. openai, and its credentials.
AGENTGUARD_LLM_PROVIDER=
AGENTGUARD_LLM_MODEL=
OPENAI_API_KEY=
# Deterministic mode is always available with: python -m agentguard --demo
# Optional: invalid_arguments, timeout, unavailable, or exception
AGENTGUARD_FAILURE_MODE=

# Local Compose bootstrap/admin role. Used only for initial setup and role administration.
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=replace-with-a-local-bootstrap-password
POSTGRES_DB=agentguard
POSTGRES_HOST_PORT=5433
AGENTGUARD_BOOTSTRAP_DATABASE_URL=postgresql+psycopg://agentguard:replace-with-a-local-bootstrap-password@localhost:5433/postgres

# Non-superuser schema owner for Alembic; no CREATEDB or CREATEROLE.
AGENTGUARD_MIGRATION_DATABASE_URL=postgresql+psycopg://agentguard_migrator:replace-with-migration-password@localhost:5433/agentguard

# Least-privilege application runtime role; no schema or administrative rights.
AGENTGUARD_DATABASE_URL=postgresql+psycopg://agentguard_app:replace-with-app-password@localhost:5433/agentguard
# Task text is omitted by default; opt in only when retention policy permits.
AGENTGUARD_STORE_TASK_TEXT=false

# Separate disposable integration DB, connected as the application role.
AGENTGUARD_TEST_DATABASE_URL=postgresql+psycopg://agentguard_app:replace-with-app-password@localhost:5433/agentguard_test
# Migration-role URL for Alembic and test cleanup only.
AGENTGUARD_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://agentguard_migrator:replace-with-migration-password@localhost:5433/agentguard_test
