# Optional provider-backed execution. Deterministic offline execution needs no API key.
AGENTGUARD_LLM_PROVIDER=
AGENTGUARD_LLM_MODEL=
OPENAI_API_KEY=

# API environment for a host-run development server. Compose sets production itself.
AGENTGUARD_API_ENVIRONMENT=development
# Optional exact comma-separated HTTP(S) origins. Leave empty to use environment defaults.
AGENTGUARD_CORS_ORIGINS=
# AGENTGUARD_API_DOCS_ENABLED=true

# Local Compose PostgreSQL bootstrap role. Generate a unique URL-safe password, e.g.
# `openssl rand -hex 32`. Do not use these settings with an existing valuable database.
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=
POSTGRES_DB=agentguard
POSTGRES_HOST_PORT=5434

# Separate migration identity. Use a distinct URL-safe password.
AGENTGUARD_MIGRATION_PASSWORD=

# Least-privilege application identity. Use a distinct URL-safe password.
AGENTGUARD_APP_PASSWORD=

# Docker Compose frontend binding; loopback by default.
AGENTGUARD_HTTP_PORT=8081

# For host-run API/migrations only, construct PostgreSQL URLs using URL-safe passwords:
# AGENTGUARD_MIGRATION_DATABASE_URL=postgresql+psycopg://agentguard_migrator:<migration-password>@127.0.0.1:5434/agentguard
# AGENTGUARD_DATABASE_URL=postgresql+psycopg://agentguard_app:<app-password>@127.0.0.1:5434/agentguard
# Keep task text out of persisted telemetry unless your retention policy allows it.
AGENTGUARD_STORE_TASK_TEXT=false

# Optional URLs for a separate disposable PostgreSQL integration-test database.
AGENTGUARD_TEST_DATABASE_URL=
AGENTGUARD_TEST_MIGRATION_DATABASE_URL=

# Optional deterministic failure injection for local development only.
# AGENTGUARD_FAILURE_MODE=invalid_arguments
